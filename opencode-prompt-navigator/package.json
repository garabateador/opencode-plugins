{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-prompt-navigator",
  "version": "1.1.0",
  "description": "Workbuddy-style prompt navigation rail for OpenCode Desktop sessions. Jumps to and highlights user inputs.",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts && vite build",
    "build:tui": "bun run scripts/build.ts",
    "build:gui": "vite build",
    "dev": "bun run scripts/build.ts --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tui.json"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/bun": "^1.4.4",
    "solid-js": "1.9.12",
    "typescript": "5.8.2",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "keywords": [
    "opencode",
    "opencode-v2",
    "plugin",
    "desktop",
    "navigation",
    "timeline"
  ],
  "license": "MIT"
}
